# Neo4j connection. Copy to .env and fill in; .env is gitignored.
# Credentials are environment, never config: they must not enter the run key,
# or the same experiment gets two different keys on two machines (D-14).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
