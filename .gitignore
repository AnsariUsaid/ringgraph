# ── Markdown ──────────────────────────────────────────────────────────────
# Only README.md is tracked. Planning notes, agent discussions and generated
# reports stay local.
*.md
!README.md

# ── Python ────────────────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.python-version

# ── Data ──────────────────────────────────────────────────────────────────
# The IEEE-CIS dataset and everything derived from it. Reproduced by scripts,
# never committed.
data/*
*.csv
*.parquet
*.zip
*.feather

# ── Reports / model artefacts ─────────────────────────────────────────────
reports/*
preds/*
models/*.txt
models/*.pkl
models/*.pt
*.joblib

# ── Neo4j ─────────────────────────────────────────────────────────────────
neo4j/
*.dump
import/

# ── Secrets ───────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
kaggle.json

# ── Node / frontend ───────────────────────────────────────────────────────
node_modules/
web/dist/
web/.vite/
*.local
npm-debug.log*
yarn-error.log*

# ── macOS / editors ───────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
.claude/
*.swp

# ── Served artefacts ──────────────────────────────────────────────────────
# Exactly what api/main.py reads, and nothing else: ~7.6 MB, so that a clone
# can run the whole app without a Kaggle account, a pipeline run or a database.
#
# Committing generated data contradicts the policy above, and the exception is
# deliberate. Regenerating these needs the competition dataset, credentials and
# several hours; without them a fresh clone serves nothing and every page is an
# error state. The inputs stay ignored -- this is the output the demo reads.
#
# Two things make these rules fussy, both verified rather than assumed:
#   * each directory level must be re-included separately, because git will not
#     descend into an excluded directory (D-04);
#   * they must come after the blanket *.parquet and *.csv rules above, because
#     the last matching rule wins.
!data/rings/
data/rings/*
!data/rings/*.parquet
!data/rings/_manifest.json

!reports/
!reports/*.json

!preds/
preds/*
!preds/model=m1_tuned/
preds/model=m1_tuned/*
!preds/model=m1_tuned/run=*/
preds/model=m1_tuned/run=*/*
!preds/model=m1_tuned/run=*/preds.parquet
